.venv/
.venv
ios/build/
artifacts/integration/*preview.html
artifacts/integration/ppocrv5-mobile-rec.int8.onnx
__pycache__/
*.pyc
# Real-document corpora: large, redistributable under their own licences
# (SROIE ICDAR2019; Express Expense CC-BY-4.0), and not ours to commit.
# the 1.1 GB training corpus at the repo root (datasets, not source). ANCHORED with a leading
# slash on purpose: unanchored, this also swallowed app/data/, so the shipped medicine lexicon
# could never be committed -- it would have shipped as a 404 on the live site.
/data/
artifacts/*.npz

# machine-local junk (never commit)
.DS_Store
**/.DS_Store
**/xcuserdata/
*.xcuserstate

# Real-photo corpus: the photographs themselves are 467 MB of CC-licensed Wikimedia
# images, re-fetchable with `bash run.sh py ml/tools/fetch_real_bottles.py`. The
# TRANSCRIPTS are the irreplaceable part (a person read them off the pixels) and they
# are tracked, so the eval set survives a fresh clone.
/data/real_bottles/raw/

# Bottle corpus: re-creatable in ~2 minutes from the tracked real label text
# (bash run.sh py ml/tools/build_bottle_corpus.py --pages 600). The TEXT is the
# irreplaceable part and data/dose_panels.txt is tracked, so a clone rebuilds it.
/data/bottle_corpus/
